# ----- Email delivery configuration -----
REPORT_EMAIL_TO=client-contact@example.com
REPORT_EMAIL_CC=soc-team@athenasecuritygrp.com
REPORT_EMAIL_FROM=sender@example.com

# ----- OpenSearch pallas-incidents source -----
OPENSEARCH_URL=https://tenant-indexer.athenasecuritygrp.com:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=pallas-incidents
# Use false for the current tenant indexers' internal CA.
OPENSEARCH_VERIFY_SSL=false

# ----- SOC 2 operational monitoring (Wazuh TSC mappings) -----
# Reads rule.tsc from the Wazuh alert index using the OpenSearch connection above.
# This is operational monitoring evidence, not an audit opinion or certification.
REPORT_ENABLE_SOC2_COMPLIANCE=true
OPENSEARCH_ALERT_INDEX=wazuh-alerts-*
# Optional click-through target for the detailed compliance evidence/dashboard.
REPORT_SOC2_COMPLIANCE_URL=
# Thresholds a criterion must clear to be marked "Met" rather than "Attention".
# SLA target matches the report's own green SLA band; closure rate is the week's
# closed-vs-raised ratio, so a healthy backlog does not read as an exception.
REPORT_SOC2_SLA_TARGET_PCT=95
REPORT_SOC2_COVERAGE_TARGET_PCT=95
REPORT_SOC2_CLOSURE_TARGET_PCT=90

# ----- Wazuh Manager agent heartbeat status -----
# Uses the same Wazuh Manager /agents data as the Agent Summary email:
# active <=24h; inactive 24-72h, 3-7d, or 7-14d; older records are excluded.
REPORT_ENABLE_AGENT_STATUS=true
WAZUH_HOST=tenant-manager.athenasecuritygrp.com
WAZUH_USER=
WAZUH_PASS=
WAZUH_VERIFY_SSL=false
# Optional when WAZUH_HOST does not already include a port.
WAZUH_PORT=55000
REPORT_AGENT_MAX_ROWS=10
# Optional click-through target for agent details. If empty, the report derives
# it from DASHBOARD_BASE_URL when that value is configured.
REPORT_AGENT_STATUS_URL=
DASHBOARD_BASE_URL=

# Jira is not queried by the report. Its URL is retained only for ticket links,
# while the project key and severity values interpret Jira state mirrored into
# pallas-incidents by the sync service.
JIRA_SITE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=
REPORT_CLIENT=<TENANT_NAME>
REPORT_TENANT=<TENANT_NAME>.athenasecuritygrp.com

# ----- Incident lifecycle fields -----
# Mirrored duration fields are preferred. If a duration is empty/unavailable,
# the report uses the corresponding timestamp pair when both fields exist.
JIRA_MTTD_FIELD=MTTD (Minutes)
JIRA_MTTT_FIELD=MTTT (Minutes)
JIRA_MTTR_FIELD=MTTR (Minutes)
JIRA_MTTC_FIELD=MTTC (Minutes)
JIRA_INCIDENT_TIME_FIELD=Incident Time (Eastern Time - ET)
JIRA_ALERT_TIME_FIELD=Alert Generated Time
JIRA_FIRST_RESPONSE_TIME_FIELD=First Response Time

# Timezone (IANA name) for every timestamp the report displays — the "Generated"
# line and the agent last-seen times. Default: US Eastern (ET). Unknown names
# fall back to UTC.
REPORT_TIMEZONE=America/New_York

# ----- Incident response SLA targets (resolution time, in minutes) -----
# Drives the "Response SLA attainment" card: % of incidents resolved within
# target, by severity.
REPORT_SLA_CRITICAL_MINUTES=240
REPORT_SLA_HIGH_MINUTES=480
REPORT_SLA_MEDIUM_MINUTES=1440
REPORT_SLA_LOW_MINUTES=4320

# ----- Vulnerability remediation SLA targets (days) -----
# Drives the "Remediation SLA attainment" card in the Vulnerability section:
# % of vulnerabilities remediated within target, by severity. These differ from
# the incident-response SLA above (hours vs days).
REPORT_VULN_SLA_CRITICAL_DAYS=7
REPORT_VULN_SLA_HIGH_DAYS=14
REPORT_VULN_SLA_MEDIUM_DAYS=30
REPORT_VULN_SLA_LOW_DAYS=90

# ----- Standard incident severity mapping -----
JIRA_SEVERITY_CRITICAL_VALUE=Sev-1
JIRA_SEVERITY_HIGH_VALUE=Sev-2
JIRA_SEVERITY_MEDIUM_VALUE=Sev-3
JIRA_SEVERITY_LOW_VALUE=Sev-4

# ----- NIDS severity mapping (tickets with [SURICATA] in the summary) -----
JIRA_NIDS_SEVERITY_CONFIRMED_VALUE=Sev-1
JIRA_NIDS_SEVERITY_CRITICAL_VALUE=Sev-2
JIRA_NIDS_SEVERITY_HIGH_VALUE=Sev-3
JIRA_NIDS_SEVERITY_MEDIUM_VALUE=Sev-4
JIRA_NIDS_SEVERITY_LOW_VALUE=Sev-4

# ----- Vulnerabilities Severity mapping -----
JIRA_VULN_SEVERITY_CRITICAL_VALUE=Sev-1
JIRA_VULN_SEVERITY_HIGH_VALUE=Sev-2
JIRA_VULN_SEVERITY_MEDIUM_VALUE=Sev-3
JIRA_VULN_SEVERITY_LOW_VALUE=Sev-4

# ----- Email delivery Configuration-----
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
REPORT_EMAIL_SUBJECT="Weekly Security Operations Report - {client} - {period}"
